# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# CVs generados por scripts/generate-resume-*.tsx (van a ~/Downloads/VCs/).
# Solo la raíz: un PDF en public/ sí se puede versionar.
/*.pdf

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code / local tooling
.agents/
.claude/skills/
.claude/attn_state.json
scripts/
skills-lock.json
graphify-out/
